# apps/api/.env.example — gastos-personales-reference
#
# Local development environment for the NestJS API. Copy to `.env` and
# fill the values; `.env` is gitignored. NEVER commit a real `.env`.
#
# Validation: every variable listed here is parsed by the Zod schema at
# `libs/core/config/env.schema.ts` (which `apps/api/src/main.ts`
# imports at boot). The process fails-fast on a missing / malformed
# value with a ZodError listing every offending field.

# ---- Runtime ----

# development | test | production
NODE_ENV=development

# The NestJS server port. Defaults to 3001 in the env schema if omitted.
PORT=3001

# Web origin (CORS + redirect targets). Required, must be a valid URL.
WEB_ORIGIN=http://localhost:3000

# ---- Database ----

# Prisma + Postgres connection string. The docker-compose.yml in the
# repo root spins up `postgres:16-alpine` on :5432; the local URL is:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gastos_personal_reference

# ---- NextAuth v5 (T3.3, slice 3 batch 7) ----

# Public URL of the auth endpoint. Used by NextAuth to compute OAuth
# callback URLs. Required, must be a valid URL.
NEXTAUTH_URL=http://localhost:3000

# Encryption secret for the NextAuth JWT. Required, min 32 chars
# (Zod schema enforces). Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32-chars-or-longer

# ---- Google OAuth (OPTIONAL — T3.3) ----
#
# The Credentials provider (email + password) is always wired. The
# Google provider is added to the providers array ONLY when both
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are present. Leave them
# blank in dev / test if you don't need to exercise the OAuth flow;
# the e2e suite in this batch uses Credentials only (real OAuth lands
# in T3.7).

# Obtain from https://console.cloud.google.com/apis/credentials
# (Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
