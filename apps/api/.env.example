# apps/api/.env.example — gastos-personales-reference
#
# Local development environment for the NestJS API. Copy to `.env` and
# fill the values; `.env` is gitignored. NEVER commit a real `.env`.
#
# Validation: every variable listed here is parsed by the Zod schema at
# `libs/core/config/env.schema.ts` (which `apps/api/src/main.ts`
# imports at boot). The process fails-fast on a missing / malformed
# value with a ZodError listing every offending field.

# ---- Runtime ----

# development | test | production
NODE_ENV=development

# The NestJS server port. Defaults to 3001 in the env schema if omitted.
PORT=3001

# Base URL the API listens on. Required for the web client to call
# POST /auth/login + POST /auth/register from the LoginForm /
# SignUpForm (slice 4 batch 4c — T4.8). The web app reads the same
# env var via the @core/config loader, so set it identically in both
# apps/api/.env and apps/web/.env.
API_URL=http://localhost:3001

# Web origin (CORS + redirect targets). Required, must be a valid URL.
WEB_ORIGIN=http://localhost:3000

# ---- Database ----

# Prisma + Postgres connection string. The docker-compose.yml in the
# repo root spins up `postgres:16-alpine` on :5432; the local URL is:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gastos_personal_reference

# ---- NextAuth v5 (T3.3, slice 3 batch 7) ----

# Public URL of the auth endpoint. Used by NextAuth to compute OAuth
# callback URLs. Required, must be a valid URL.
NEXTAUTH_URL=http://localhost:3000

# Encryption secret for the NextAuth JWT. Required, min 32 chars
# (Zod schema enforces). Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32-chars-or-longer

# ---- Google OAuth (OPTIONAL — T3.3) ----
#
# The Credentials provider (email + password) is always wired. The
# Google provider is added to the providers array ONLY when both
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are present. Leave them
# blank in dev / test if you don't need to exercise the OAuth flow;
# the e2e suite in this batch uses Credentials only (real OAuth lands
# in T3.7).

# Obtain from https://console.cloud.google.com/apis/credentials
# (Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Gmail mail transport (D7) ----
#
# The Gmail service transport requires a Google account with 2FA enabled
# and an App Password (NOT the regular login password). Generate one at
# https://myaccount.google.com/apppasswords. The transport is activated
# when BOTH GMAIL_USER and GMAIL_APP_PASSWORD are populated AND MAIL_DSN
# is unset AND NODE_ENV=production. Any non-empty MAIL_DSN short-circuits
# the Gmail path and binds ConsoleMailAdapter instead (the kill-switch).
#
# Leave both blank in dev / test — the @core/config superRefine permits
# their absence outside production. In production, deployers must set
# EITHER a real MAIL_DSN (e.g. smtp://relay:587) OR these two Gmail vars.

# Gmail address that owns the App Password.
GMAIL_USER=

# 16-character App Password (Google renders them with spaces; strip them).
GMAIL_APP_PASSWORD=

# ---- Admin surface kill-switch (M3 — module-3-superadmin) ----
#
# When `true` (the default), the /admin/* routes are guarded by
# AdminGuard and 403/404 per design. When `false`, AdminGuard
# short-circuits every admin request with 404 to hide the surface
# entirely — the kill-switch per design D1 + D8. Operators flip to
# `false` for an emergency response without redeploying. Coerced from
# the string forms the env schema accepts: true|false|1|0|yes|no|on|off
# (case-insensitive). OPTIONAL — the schema defaults to `true` and the
# superRefine never requires it.
ADMIN_ENABLED=true

# ---- Audit retention (M4 — module-4-privacy) ----
#
# Per design D8 + `openspec/specs/audit-log-ui/spec.md` "Audit
# Retention Environment Variable". Two cooperating knobs:
#
#   AUDIT_RETENTION_DAYS — the automatic purge window in days.
#       Default 90. `0` is the kill-switch (no automatic purge;
#       operators run purge manually via `POST /admin/audit/purge`
#       with `{ "dryRun": false, "olderThanDays": <n> }`).
#       Coerced from the string forms env loaders deliver ("90",
#       "30", "0"); `min(0)` rejects negatives at boot.
#   AUDIT_RETENTION_ENABLED — opt-in gate for the daily cron
#       (per D2). When `true`, the cron runs at 03:00 UTC and
#       calls `auditService.purgeOlderThan(days)`. Default `false`
#       keeps the cron off in dev / test so the schedule does not
#       interfere with the test harness. Coerced from the same
#       boolean string forms as ADMIN_ENABLED
#       (true|false|1|0|yes|no|on|off, case-insensitive).
#
# Both variables are OPTIONAL — the schema defaults are 90 / false.
AUDIT_RETENTION_DAYS=90
AUDIT_RETENTION_ENABLED=false

# ---- Password hashing (M5 — module-5-production-hardening) ----
#
# Optional bcrypt work-factor override. Unset uses the production default
# of 12. Tests may set 4 to keep the suite fast. Values below 4, fractional
# values, and non-numeric values fail environment validation at boot.
# BCRYPT_COST_FACTOR_OVERRIDE=4
