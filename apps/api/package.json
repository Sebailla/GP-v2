{
  "name": "api",
  "version": "1.1.1",
  "private": true,
  "description": "NestJS 10 API for gastos-personales-reference. Slice 1 ships a minimal app module that boots on :3001; feature modules land in slices 3 (auth) and 5 (transactions).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "pnpm exec eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.7.4",
    "@core/config": "workspace:*",
    "@core/database": "workspace:*",
    "@core/events": "workspace:*",
    "@core/logging": "workspace:*",
    "@core/rate-limit": "workspace:*",
    "@features/auth": "workspace:*",
    "@features/transactions": "workspace:*",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/schedule": "6.1.3",
    "@shared-utils/decimal": "workspace:*",
    "bcryptjs": "2.4.3",
    "nanoid": "5.0.7",
    "next-auth": "5.0.0-beta.25",
    "nodemailer": "^6.10.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.27",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.0",
    "@types/node": "22.18.0",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "6.0.2",
    "eslint": "10.6.0",
    "nodemailer-mock": "^1.5.12",
    "supertest": "7.0.0",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
