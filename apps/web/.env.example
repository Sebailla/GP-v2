# apps/web/.env.example — gastos-personales-reference
#
# Local development environment for the Next.js web client. Copy to
# `.env.local` and fill the values; `.env*` is gitignored. NEVER commit
# a real `.env`.
#
# Validation: every variable listed here is parsed by the Zod schema at
# `libs/core/config/env.schema.ts` (which `apps/web/app/[locale]/page.tsx`
# imports at module load). The process fails-fast on a missing or
# malformed value with a ZodError listing every offending field.

# ---- Runtime ----

# development | test | production
NODE_ENV=development

# Base URL of the NestJS API. The web client POSTs to ${API_URL}/auth/*
# from the LoginForm / SignUpForm (slice 4 batch 4c — T4.8 + T4.9).
# In dev: matches apps/api's PORT (default 3001).
API_URL=http://localhost:3001

# Web origin (used for CORS allow-list on the API and as the NextAuth
# canonical URL — required by @core/config, must be a valid URL).
WEB_ORIGIN=http://localhost:3000

# ---- Database ----
#
# The web client does NOT query the database directly (Prisma lives in
# libs/core/database and is consumed by apps/api only). Listed here for
# symmetry with apps/api/.env.example; the schema requires it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gastos_personal_reference

# ---- NextAuth v5 (T3.3, slice 3 batch 7) ----
#
# Public URL of the auth endpoint. Used by NextAuth to compute OAuth
# callback URLs. Required, must be a valid URL.
NEXTAUTH_URL=http://localhost:3000

# Encryption secret for the NextAuth JWT. Required, min 32 chars
# (Zod schema enforces). Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32-chars-or-longer
