# apps/web/.env.test — CI fixture for the BDD (Cucumber) job
#
# This file provides env vars for `next build` when invoked with
# NODE_ENV=test (which is the case for the BDD job's transitive
# `web#build` step). The values are placeholders that satisfy the
# Zod schema at libs/core/config/env.schema.ts without leaking
# any production secrets. Every value here is mirrored from the
# job-level `env:` block of `.github/workflows/ci.yml` so the
# local and CI builds see the same shape.
#
# Why this file exists:
# apps/web's RSC pages (notably dev/mailbox/[userId]/page.tsx) and
# the catch-all NextAuth route (app/api/auth/[...nextauth]/route.ts)
# import `env` from @core/config at module load. next build bundles
# these modules during page-data collection, and the worker processes
# do not reliably inherit the env vars set on the parent shell in
# CI (where the BDD job's job-level `env:` block is the only source
# of truth). The `.gitignore` blocks `.env.local` and `.env.production`
# but does NOT block `.env.test`, so this fixture is committed
# alongside the other `.env*` examples.
#
# DO NOT use these values outside the BDD job's `next build` step.
# In production, real env values are loaded from the deployment
# platform's secret store (see apps/web/.env.example for the schema).

NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gastos_reference_test
NEXTAUTH_SECRET=ci-only-do-not-use-in-prod-32-chars-min
NEXTAUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
JWT_SECRET=ci-only-jwt-secret-at-least-32-characters-long
COOKIE_SECRET=ci-only-cookie-secret-at-least-32-characters-long
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
METRICS_TOKEN=ci-only-metrics-token-at-least-16
STATUS_DETAIL_TOKEN=ci-only-status-detail-token-at-least-16
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=ci-only-upstash-token-at-least-16-chars
LOG_LEVEL=info
