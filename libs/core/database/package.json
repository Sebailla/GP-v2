{
  "name": "@core/database",
  "version": "1.3.0",
  "private": true,
  "description": "Prisma client singleton + schema for gastos-personales-reference. The single source of truth for `new PrismaClient()` — enforced by the `no-prisma-outside-core` ESLint rule from T1.3. Consumed via the @core/database path alias from feature server slices.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.682.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.8.0",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@prisma/config": "7.8.0",
    "@types/node": "22.18.0",
    "eslint": "^10.6.0",
    "prisma": "7.8.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
