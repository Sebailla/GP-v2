// Prisma schema for gastos-personales-reference.
//
// Single source of truth for the database tables. The schema covers the
// AUTH slice tables (User, Account, Session, VerificationToken,
// PasswordResetToken) required by `specs/auth/spec.md` "Data Model".
// Transactions tables (Currency, FxRate, Category, Transaction,
// IdempotencyKey, AuditLog) land in slice 5.
//
// Prisma 7.x note: the `url` property is NO LONGER supported in the
// datasource block of `schema.prisma`. The connection URL is configured
// in `prisma.config.ts` (see that file) and passed to `PrismaClient`
// via `datasourceUrl` at construction time. The `prisma.config.ts` is
// where `env("DATABASE_URL")` is read.

generator client {
  provider = "prisma-client"
  // Prisma 7 requires an explicit output path. Place the generated
  // client inside the package's src/ so the resolver can find it via
  // a relative import from ./client.ts.
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// AUTH slice (slice 2 — this file)
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  hashedPassword String?
  role           Role      @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  userPreference      UserPreference?

  // Slice 5 back-relations (T5.1)
  transactionsCreated Transaction[]    @relation("TransactionCreatedBy")
  transactionsUpdated Transaction[]    @relation("TransactionUpdatedBy")
  idempotencyKeys     IdempotencyKey[]
  auditLogs           AuditLog[]       @relation("AuditLogActor")
  // Slice 5 PR #2: closes the PR #1 W1 readability finding (the
  // CategoryRepository.softDelete contract references this column).
  categoriesUpdated   Category[]       @relation("CategoryUpdatedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  // M4 (module-4-privacy) — session creation timestamp. Required
  // for the spec-literal 6-field list projection (per design D7 +
  // the auth-server-surface spec's "Session List Projection"
  // requirement). Nullable so the column is additive: every
  // pre-M4 session row has NULL and stays readable. The schema
  // `default(now())` populates the column on every NEW session
  // insert going forward; pre-existing rows are NULL until
  // PR #2 wires a backfill (the spec accepts the NULL).
  createdAt    DateTime? @default(now())
  // M3 (module-3-superadmin) — nullable JSON column. The `?` is
  // non-negotiable: every session row predates this column and must
  // remain readable. The column is admin-side metadata (e.g. last
  // seen device label, sign-in surface) and never influences the
  // auth path. See `openspec/changes/module-3-superadmin/design.md`
  // §4 for the migration story + §5 for the data shape contract.
  metadata     Json?
  // M4 (module-4-privacy) — last-active timestamp. Nullable so the
  // column is additive (no backfill required): every session row
  // predates the column and the coalesce-write pattern in
  // `SessionService.getCurrentUser` (per design D1) treats
  // `lastActiveAt IS NULL` as "never seen yet, write now". The
  // `@@index` below keeps the `list()` ORDER BY `lastActiveAt DESC`
  // and the coalesce UPDATE off a seq-scan path. See
  // `openspec/changes/module-4-privacy/design.md` §2 (D1) + §2 (D7).
  lastActiveAt DateTime?
  // M4 (module-4-privacy) — UA + IP captured at the controller
  // boundary (per design D7 + the auth-server-surface spec's "Session
  // List Projection" requirement). Same shape as the audit log
  // columns: UA ≤ 512 chars, IP ≤ 45 chars (IPv6-mapped IPv4 max
  // length). Both nullable so the columns are additive — every
  // pre-M4 session row has NULL for both. The IP stored here is the
  // RAW IP; HMAC conversion for admin responses happens at the
  // controller projection boundary (per `pattern/pino-bracket-notation-
  // redaction`, log lines carrying it are redacted at the LOG layer).
  userAgent  String? @db.VarChar(512)
  ipAddress  String? @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastActiveAt])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // (userId, consumedAt) supports the typical query: "list a user's
  // active (unconsumed) reset tokens". (expiresAt, consumedAt)
  // supports `deleteExpired(before)` (R3 follow-up to the 4R review
  // for slice 3 batch 5): the cron that lands in slice 6 (T3.6)
  // deletes where `expiresAt < now AND consumedAt IS NULL` — this
  // composite index keeps the prune off the seq-scan path.
  @@index([userId, consumedAt])
  @@index([expiresAt, consumedAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// M3 ADMIN AUDIT (module-3-superadmin — D2)
//
// Append-only audit log for every admin operation (CHANGE_ROLE,
// REVOKE_SESSION, REVOKE_ALL_SESSIONS). The IP and UA are captured at
// the controller boundary (D3) so the service layer stays HTTP-agnostic.
// Retention is deferred to M4 (D7) — the @@index([createdAt]) keeps the
// eventual purge query off a seq-scan path.
//
// Pino `[ip]` redaction (per `pattern/pino-bracket-notation-redaction`)
// is applied at the LOG layer, not here. This table is the row-of-record
// — the IP is stored as captured, but log lines carrying it must be
// redacted by pino's bracket-notation redaction paths.
// ---------------------------------------------------------------------------

enum AdminAuditAction {
  REVOKE_SESSION
  REVOKE_ALL_SESSIONS
  CHANGE_ROLE
}

model AdminAuditEvent {
  id        String           @id @default(cuid())
  actorId   String
  targetId  String
  action    AdminAuditAction
  createdAt DateTime         @default(now())
  metadata  Json
  // HMAC-SHA256 digests are persisted as 64-character lowercase hex.
  ipAddress String?          @db.VarChar(64)
  // UA ≤ 512 chars. Truncated to 512 chars at the controller boundary
  // before insert (per threat matrix §7 — IP + UA handling).
  userAgent String?          @db.VarChar(512)

  @@index([createdAt])
  @@map("admin_audit_events")
}

// ---------------------------------------------------------------------------
// TRANSACTIONS slice (slice 5 — T5.1)
//
// Single source of truth for money math lives in @shared-utils/decimal
// (`decimal.js`-backed). The Prisma `Decimal` column type stores values as
// `numeric` on Postgres. Adapters in `libs/features/transactions/server/`
// convert Prisma's runtime Decimal → `@shared-utils/decimal`'s `Decimal`
// at the boundary so the domain layer keeps a single numeric vocabulary.
// ---------------------------------------------------------------------------

enum CategoryKind {
  income
  expense
}

enum TransactionKind {
  income
  expense
}

model Currency {
  // ISO 4217 alphabetic code (USD, ARS, EUR). Natural key — no cuid here
  // because currencies are reference data and the code is the canonical id.
  code      String   @id
  name      String
  symbol    String
  decimals  Int      @default(2)
  createdAt DateTime @default(now())

  fxRatesFrom           FxRate[]      @relation("FxRateFrom")
  fxRatesTo             FxRate[]      @relation("FxRateTo")
  transactionsFrom      Transaction[] @relation("TransactionCurrency")
  transactionsReporting Transaction[] @relation("TransactionReportingCurrency")
  userPreferences       UserPreference[]

  @@map("currencies")
}

/**
 * Per-user reporting preferences. Owned by the module-6-reports slice's
 * `findPrimaryCurrencyForUser` port implementation. The `primaryCurrencyCode`
 * is the canonical ISO 4217 code the user wants to see aggregated reports
 * in. When `null`, the `ReportsService` falls back to USD with a
 * `console.warn` + observability counter (per spec S18).
 *
 * Why a separate model (not a field on `User`): keeping reporting
 * preferences on a side table isolates the "config" shape from the
 * "identity" shape and lets future reporting preferences (e.g. default
 * date range, week-start day) extend without an `User` migration.
 *
 * One row per user. The `userId` is the natural primary key (1:1 with
 * `User`) — `findUnique({ where: { userId } })` is the canonical lookup.
 */
model UserPreference {
  userId             String   @id
  primaryCurrencyCode String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency Currency? @relation(fields: [primaryCurrencyCode], references: [code], onDelete: SetNull)

  @@map("user_preferences")
}

model FxRate {
  id         String   @id @default(cuid())
  fromCode   String
  toCode     String
  rate       Decimal
  recordedAt DateTime

  from Currency @relation("FxRateFrom", fields: [fromCode], references: [code], onDelete: Restrict)
  to   Currency @relation("FxRateTo", fields: [toCode], references: [code], onDelete: Restrict)

  // Back-relation: a single FxRate can be referenced by many Transactions
  // (until the rate is superseded). The Transaction.fxRate FK uses
  // onDelete: SetNull, so deleting an FxRate leaves the transaction intact
  // but signals "no FX rate is associated anymore" — the reportingAmount
  // stays valid because it was computed at write time.
  transactions Transaction[]

  // Most-recent lookup: "give me the latest FX rate from X to Y".
  // The DESC on `recordedAt` lets the Prisma adapter use a bounded index scan.
  @@index([fromCode, toCode, recordedAt(sort: Desc)])
  @@map("fx_rates")
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  kind      CategoryKind
  // Audit-trail parity with Transaction (createdBy / updatedBy).
  // updatedBy is set by the adapter on create (= the creator's id) and
  // overwritten on every update + softDelete with the actor's id.
  // Per PR #1 W1 readability finding: the port claimed this column
  // exists; PR #2 lands the column + closes the contract gap.
  updatedBy String
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions Transaction[]
  updatedByUser User    @relation("CategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([kind, deletedAt])
  @@map("categories")
}

model Transaction {
  id                    String          @id @default(cuid())
  // D-TX-6: Decimal (numeric on Postgres), NEVER BigInt — BigInt truncates cents.
  // Positive magnitude; sign is derived from `kind` (expense → negative for totals;
  // income → positive). The TotalsService owns that translation; this column is
  // always positive.
  amount                Decimal
  currencyCode          String
  kind                  TransactionKind
  reportingAmount       Decimal?
  reportingCurrencyCode String?
  fxRateId              String?
  categoryId            String
  notes                 String?
  occurredAt            DateTime
  createdBy             String
  updatedBy             String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  currency          Currency  @relation("TransactionCurrency", fields: [currencyCode], references: [code], onDelete: Restrict)
  reportingCurrency Currency? @relation("TransactionReportingCurrency", fields: [reportingCurrencyCode], references: [code], onDelete: Restrict)
  fxRate            FxRate?   @relation(fields: [fxRateId], references: [id], onDelete: SetNull)
  category          Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdByUser     User      @relation("TransactionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser     User      @relation("TransactionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  idempotencyKeys IdempotencyKey[]

  @@index([createdBy, occurredAt(sort: Desc)])
  @@index([categoryId, deletedAt])
  @@index([currencyCode, occurredAt(sort: Desc)])
  @@map("transactions")
}

model IdempotencyKey {
  id                 String   @id @default(cuid())
  key                String
  userId             String
  requestFingerprint String
  responsePayload    Json
  responseStatus     Int
  transactionId      String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  // (userId, key) is the unique replay key: the same key from a different
  // user is a different slot, the same key from the same user is the same slot.
  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String // "Transaction" | "Category"
  // Polymorphic id; resolved by `entityType` at read time. Intentionally NOT
  // a Prisma FK — the same column holds Transaction or Category IDs.
  entityId   String
  action     String // "create" | "update" | "softDelete"
  actorId    String
  payload    Json?
  createdAt  DateTime @default(now())

  actor User @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// BACKUP (slice — R-PF-7)
//
// Audit trail for the daily `pg_dump` job. One row per `runBackup`
// invocation. The /status endpoint reads the most recent row to surface
// `lastBackupAt` and `lastBackupStatus`.
//
// The `environment` column is REQUIRED because staging and production
// share the same Postgres host; without it the /status endpoint on
// production would happily report the staging backup timestamp.
// ---------------------------------------------------------------------------

model BackupRun {
  id          String   @id @default(cuid())
  performedAt DateTime @default(now())
  status      String
  bytes       Int?
  storageKey  String?
  message     String?
  environment String
}
